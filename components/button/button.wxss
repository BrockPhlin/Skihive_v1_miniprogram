/* Button Component Styles */

/* ==================== Base Button ==================== */
.sk-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  font-family: system-ui, -apple-system, sans-serif;
  transition: all 0.2s ease-out;
  border: none;
  outline: none;
  -webkit-tap-highlight-color: transparent;
}

.sk-button::before {
  display: none;
}

/* ==================== Type Variants ==================== */
/* Primary */
.sk-button.primary {
  background: linear-gradient(135deg, #855ee3 0%, #6c4bd4 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(133, 94, 227, 0.4);
}

.sk-button.primary.plain {
  background: rgba(133, 94, 227, 0.15);
  color: #9d7ff0;
  box-shadow: none;
}

.sk-button.primary:not(.plain):active {
  background: linear-gradient(135deg, #6c4bd4 0%, #5a3db8 100%);
  box-shadow: 0 2rpx 8rpx rgba(133, 94, 227, 0.3);
}

/* Secondary */
.sk-button.secondary {
  background: linear-gradient(135deg, #e67e22 0%, #d35400 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(230, 126, 34, 0.4);
}

.sk-button.secondary.plain {
  background: rgba(230, 126, 34, 0.15);
  color: #f39c12;
  box-shadow: none;
}

.sk-button.secondary:not(.plain):active {
  background: linear-gradient(135deg, #d35400 0%, #c0392b 100%);
  box-shadow: 0 2rpx 8rpx rgba(230, 126, 34, 0.3);
}

/* Ghost */
.sk-button.ghost {
  background: transparent;
  color: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: none;
}

.sk-button.ghost:active {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.5);
}

.sk-button.ghost.plain {
  background: transparent;
  color: rgba(255, 255, 255, 0.6);
}

/* Danger */
.sk-button.danger {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.4);
}

.sk-button.danger.plain {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
  box-shadow: none;
}

.sk-button.danger:not(.plain):active {
  background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.3);
}

/* Success */
.sk-button.success {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.4);
}

.sk-button.success.plain {
  background: rgba(34, 197, 94, 0.15);
  color: #4ade80;
  box-shadow: none;
}

.sk-button.success:not(.plain):active {
  background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
  box-shadow: 0 2rpx 8rpx rgba(34, 197, 94, 0.3);
}

/* ==================== Size Variants ==================== */
.sk-button.small {
  height: 56rpx;
  padding: 0 24rpx;
  font-size: 22rpx;
  border-radius: 28rpx;
}

.sk-button.medium {
  height: 72rpx;
  padding: 0 36rpx;
  font-size: 26rpx;
  border-radius: 36rpx;
}

.sk-button.large {
  height: 88rpx;
  padding: 0 48rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
}

/* ==================== Shape Variants ==================== */
.sk-button.pill {
  border-radius: 100rpx !important;
}

.sk-button.circle {
  border-radius: 50% !important;
  padding: 0 !important;
  min-width: 72rpx;
}

.sk-button.circle.small {
  min-width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.sk-button.circle.medium {
  min-width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.sk-button.circle.large {
  min-width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

/* ==================== Block ==================== */
.sk-button.block {
  display: flex;
  width: 100%;
}

/* ==================== Disabled ==================== */
.sk-button.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.sk-button.disabled:active {
  transform: none !important;
}

/* ==================== Loading ==================== */
.sk-button.loading {
  pointer-events: none;
}

.sk-button.loading .sk-button-content {
  opacity: 0.5;
}

/* ==================== Pressed State ==================== */
.sk-button.pressed {
  transform: scale(0.95);
}

.sk-button:active:not(.disabled):not(.loading) {
  transform: scale(0.95);
}

/* ==================== Button Wrap ==================== */
.sk-button-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

/* ==================== Icon ==================== */
.sk-button-icon {
  margin-right: 8rpx;
  font-size: 1.2em;
}

/* ==================== Loading Spinner ==================== */
.sk-button-loading {
  margin-right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ==================== Ripple Effect ==================== */
.ripple {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.4s ease-out, height 0.4s ease-out, opacity 0.4s ease-out;
  opacity: 0;
  pointer-events: none;
}

.sk-button:active:not(.disabled):not(.loading) .ripple {
  width: 200%;
  height: 200%;
  opacity: 0;
}

/* ==================== Content ==================== */
.sk-button-content {
  display: flex;
  align-items: center;
  white-space: nowrap;
}