/* story.wxss */
.story-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  padding-top: 60rpx;
}

.nav-back {
  font-size: 40rpx;
  color: #fff;
  width: 60rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

/* 章节标题区域 */
.chapter-header {
  text-align: center;
  padding: 40rpx 30rpx 30rpx;
}

.chapter-number {
  font-size: 24rpx;
  color: #855ee3;
  margin-bottom: 10rpx;
  letter-spacing: 4rpx;
}

.chapter-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 15rpx;
}

.chapter-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
}

/* 剧情内容区域 */
.story-content {
  flex: 1;
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
}

.dialogue-container {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.character-name {
  font-size: 28rpx;
  color: #855ee3;
  font-weight: bold;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
}

.character-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #855ee3 0%, #6c4bd4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 15rpx;
  font-size: 32rpx;
}

.dialogue-text {
  font-size: 30rpx;
  color: #fff;
  line-height: 1.8;
  min-height: 80rpx;
}

.cursor-blink {
  display: inline-block;
  width: 4rpx;
  height: 36rpx;
  background: #855ee3;
  animation: blink 1s infinite;
  vertical-align: middle;
  margin-left: 4rpx;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 剧情叙述 */
.narration-box {
  background: rgba(255, 215, 0, 0.1);
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 30rpx;
  border-left: 4rpx solid #ffd700;
}

.narration-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.7;
}

/* 选项列表 */
.options-container {
  padding: 20rpx 0;
}

.options-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 20rpx;
  text-align: center;
}

.option-item {
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 25rpx 30rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
}

.option-item:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.15);
}

.option-id {
  display: inline-block;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: linear-gradient(135deg, #855ee3 0%, #6c4bd4 100%);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.option-text {
  font-size: 28rpx;
  color: #fff;
  display: inline-block;
  vertical-align: middle;
  flex: 1;
}

.option-tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 15rpx;
}

.tag-main {
  background: rgba(133, 94, 227, 0.3);
  color: #b794f6;
}

.tag-branch {
  background: rgba(255, 215, 0, 0.2);
  color: #ffd700;
}

.tag-secret {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

/* 选项淡入动画 */
.option-item {
  animation: fadeInUp 0.5s ease forwards;
  opacity: 0;
}

.option-item:nth-child(1) { animation-delay: 0.1s; }
.option-item:nth-child(2) { animation-delay: 0.3s; }
.option-item:nth-child(3) { animation-delay: 0.5s; }

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 确认动画 */
.confirm-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.confirm-box {
  background: linear-gradient(180deg, #2a2a4a 0%, #1a1a2e 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 0 60rpx;
  border: 2rpx solid rgba(133, 94, 227, 0.5);
  text-align: center;
  animation: scaleIn 0.3s ease;
}

@keyframes scaleIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.confirm-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.confirm-choice {
  font-size: 28rpx;
  color: #ffd700;
  margin-bottom: 15rpx;
}

.confirm-result {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 30rpx;
  line-height: 1.6;
}

.confirm-buttons {
  display: flex;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.confirm-btn.cancel {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
}

.confirm-btn.confirm {
  background: linear-gradient(135deg, #855ee3 0%, #6c4bd4 100%);
  color: #fff;
}

/* 隐藏结局提示 */
.secret-hint {
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.2) 100%);
  border: 2rpx solid rgba(239, 68, 68, 0.4);
  border-radius: 16rpx;
  padding: 25rpx;
  margin-top: 20rpx;
  text-align: center;
}

.secret-hint-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.secret-hint-text {
  font-size: 24rpx;
  color: #ef4444;
}

.secret-hint-title {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin: 10rpx 0;
}

.secret-hint-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 进度指示器 */
.progress-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  gap: 10rpx;
}

.progress-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.progress-dot.active {
  background: #855ee3;
  width: 36rpx;
  border-radius: 6rpx;
}

.progress-dot.completed {
  background: #22c55e;
}

/* 底部装饰 */
.story-footer {
  padding: 30rpx;
  text-align: center;
}

.footer-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 章节选择模式 */
.chapter-list {
  padding: 30rpx;
}

.chapter-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

.chapter-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #855ee3, #6c4bd4);
}

.chapter-card.locked {
  opacity: 0.5;
}

.chapter-card.locked::before {
  background: rgba(255, 255, 255, 0.2);
}

.chapter-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.chapter-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #855ee3 0%, #6c4bd4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.chapter-card.locked .chapter-icon {
  background: rgba(255, 255, 255, 0.1);
}

.chapter-card-info {
  flex: 1;
}

.chapter-card-num {
  font-size: 22rpx;
  color: #855ee3;
  margin-bottom: 5rpx;
}

.chapter-card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.chapter-card-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 15rpx;
}

.chapter-status {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.status-tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-new {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

.status-progress {
  background: rgba(255, 215, 0, 0.2);
  color: #ffd700;
}

.status-completed {
  background: rgba(34, 197, 94, 0.2);
  color: #22c55e;
}

.status-locked {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.5);
}

.chapter-progress {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}