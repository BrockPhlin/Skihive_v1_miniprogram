/* result.wxss */
.result-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.result-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding-bottom: 40rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 40rpx;
  padding-top: 30rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

/* 飞行结果 */
.flight-outcome {
  margin: 30rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, rgba(133, 94, 227, 0.2), rgba(133, 94, 227, 0.1));
  border: 2rpx solid rgba(133, 94, 227, 0.5);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.outcome-icon {
  font-size: 80rpx;
  margin-bottom: 10rpx;
}

.outcome-text {
  font-size: 36rpx;
  color: #855ee3;
  font-weight: bold;
}

/* 提前结束警告 */
.early-end-warning {
  margin: 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(245, 108, 108, 0.2), rgba(245, 108, 108, 0.1));
  border: 2rpx solid rgba(245, 108, 108, 0.5);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.warning-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.warning-text {
  font-size: 32rpx;
  color: #f56c6c;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.warning-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.drone-showcase {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
}

.showcase-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
}

.drone-preview {
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #855ee3;
}

.drone-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.drone-icon {
  font-size: 100rpx;
}

.drone-info {
  margin-top: 20rpx;
  text-align: center;
}

.drone-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.drone-color {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

.task-tag {
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
  background: rgba(133, 94, 227, 0.3);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #fff;
}

.story-grid {
  padding: 30rpx;
}

.grid-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
}

.grid-container {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 50%;
  height: 200rpx;
  padding-right: 15rpx;
  padding-bottom: 15rpx;
  box-sizing: border-box;
}

.grid-item:nth-child(2n) {
  padding-right: 0;
}

.grid-item-inner {
  height: 100%;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.grid-item-inactive .grid-item-inner {
  opacity: 0.4;
}

.grid-placeholder {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.grid-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.story-section {
  padding: 30rpx;
}

.story-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
}

.story-text {
  background: rgba(255, 255, 255, 0.1);
  padding: 30rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 1.8;
}

/* 事件故事区域 */
.event-story-section {
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(133, 94, 227, 0.1));
  border: 2rpx solid rgba(255, 215, 0, 0.3);
  border-radius: 20rpx;
}

.event-story-title {
  font-size: 28rpx;
  color: #ffd700;
  margin-bottom: 20rpx;
  font-weight: 600;
}

.event-story-content {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.8;
  white-space: pre-line;
}

.event-score-bonus {
  margin-top: 20rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid rgba(255, 215, 0, 0.2);
  font-size: 28rpx;
  color: #67c23a;
  font-weight: 600;
}

.personality-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
}

.personality-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.personality-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin: 15rpx 0;
  text-align: center;
}

.personality-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.score-section {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
  margin: 0 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.score-item {
  text-align: center;
}

.score-item-highlight {
  background: rgba(133, 94, 227, 0.3);
  padding: 15rpx 25rpx;
  border-radius: 15rpx;
  margin: -15rpx 0;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 8rpx;
}

.score-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.score-item-highlight .score-value {
  color: #855ee3;
}

.bottom-actions {
  display: flex;
  padding: 40rpx 30rpx;
}

.btn-share {
  flex: 1;
  padding: 30rpx;
  background: linear-gradient(135deg, #855ee3 0%, #6c4bd4 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.btn-home {
  flex: 1;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  font-size: 30rpx;
}