/* assembly.wxss - composer workspace */
.assembly-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding-bottom: 140rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  padding-top: 60rpx;
}

.nav-back {
  font-size: 40rpx;
  color: #fff;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

.task-banner {
  text-align: center;
  padding: 20rpx;
  margin: 0 30rpx;
  margin-top: 39rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  overflow: hidden;
}

.task-image {
  width: 100%;
  height: 600rpx;
  border-radius: 15rpx;
  margin-bottom: 15rpx;
  display: inline-block;
  box-sizing: border-box;
}

.task-name {
  color: #fff;
  font-size: 28rpx;
}

.preview-section {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
  padding-top: 79rpx;
}

.drone-preview {
  width: 437rpx;
  height: 460rpx;
  display: flex;
  box-sizing: border-box;
  position: relative;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.assembly-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
  z-index: 0;
}

.preview-color {
  width: 80rpx;
  height: 30rpx;
  border-radius: 15rpx;
  margin-top: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.section {
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.sub-section {
  margin-bottom: 30rpx;
}

.sub-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 15rpx;
}

.module-scroll {
  white-space: nowrap;
}

.module-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.module-item {
  border-radius: 20rpx;
  padding: 20rpx;
  margin-right: 20rpx;
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.module-item-normal {
  background: rgba(40, 40, 60, 0.8);
  border: 2rpx solid rgba(100, 100, 120, 0.3);
}

.module-item-selected {
  background: rgba(133, 94, 227, 0.6);
  border: 2rpx solid #855ee3;
  box-shadow: 0 0 20rpx rgba(133, 94, 227, 0.5);
}

.module-icon {
  font-size: 50rpx;
}

.module-name {
  font-size: 22rpx;
  color: #fff;
  margin-top: 10rpx;
  text-align: center;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
}

.option-item {
  padding: 15rpx 25rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.2s;
}

.option-item.selected {
  background: rgba(133, 94, 227, 0.4);
  border: 2rpx solid #855ee3;
  box-shadow: 0 0 15rpx rgba(133, 94, 227, 0.3);
}

.option-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.option-name {
  font-size: 24rpx;
  color: #fff;
}

.color-list {
  display: flex;
  flex-wrap: wrap;
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
  padding: 15rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.2s;
}

.color-item.selected {
  border: 2rpx solid #855ee3;
  background: rgba(133, 94, 227, 0.3);
  box-shadow: 0 0 15rpx rgba(133, 94, 227, 0.3);
}

.color-swatch {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  margin-bottom: 8rpx;
}

.color-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.feedback-section {
  margin: 30rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.feedback-text {
  font-size: 30rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 30rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.stat-bar {
  width: 80rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  overflow: hidden;
}

.stat-value {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 8rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  padding-bottom: 60rpx;
  background: rgba(26, 26, 46, 0.95);
}

.start-btn {
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(135deg, #855ee3 0%, #6c4bd4 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 30rpx rgba(133, 94, 227, 0.4);
}