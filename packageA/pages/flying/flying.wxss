/* flying.wxss */
.flying-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding-bottom: 40rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  padding-top: 30rpx;
}

.nav-back {
  font-size: 40rpx;
  color: #fff;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

.task-banner {
  text-align: center;
  margin: 0 30rpx 30rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.task-name {
  color: #fff;
  font-size: 28rpx;
}

.drone-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.drone-image {
  width: 300rpx;
  height: 300rpx;
  border-radius: 40rpx;
}

.drone-icon {
  font-size: 150rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.drone-name {
  color: #fff;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.flight-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.status-badge {
  padding: 15rpx 40rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 30rpx;
}

.status-badge.flying {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  animation: pulse 1s infinite;
}

.status-badge.idle {
  background: rgba(255, 255, 255, 0.2);
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.time-display {
  display: flex;
  align-items: baseline;
}

.time-value {
  font-size: 100rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 10rpx;
}

.time-unit {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
}

.event-progress {
  margin-top: 20rpx;
}

.event-progress-text {
  font-size: 24rpx;
  color: #ffd700;
  background: rgba(255, 215, 0, 0.15);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.stats-card {
  margin: 0 30rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.stats-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.stat-box {
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.total-score {
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.score-num {
  color: #855ee3;
  font-weight: bold;
  font-size: 36rpx;
}

.controls {
  display: flex;
  justify-content: center;
  padding: 40rpx 30rpx;
}

.control-btn {
  padding: 25rpx 50rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  margin-right: 30rpx;
}

.control-btn:last-child {
  margin-right: 0;
}

.control-btn.start {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #fff;
}

.control-btn.stop {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #fff;
}

.control-btn[disabled] {
  opacity: 0.5;
}

.finish-section {
  padding: 0 30rpx;
}

.finish-btn {
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(135deg, #855ee3 0%, #6c4bd4 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 30rpx rgba(133, 94, 227, 0.4);
}

/* 事件信息展示 */
.event-indicator {
  position: fixed;
  top: 120rpx;
  right: 30rpx;
  background: rgba(255, 215, 0, 0.2);
  border: 2rpx solid rgba(255, 215, 0, 0.5);
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  animation: glow 2s infinite;
}

.event-indicator-icon {
  font-size: 28rpx;
}

.event-indicator-text {
  font-size: 24rpx;
  color: #ffd700;
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 10rpx rgba(255, 215, 0, 0.3); }
  50% { box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.6); }
}

/* 飞行记录 */
.event-log {
  margin: 20rpx 30rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.log-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 15rpx;
}

.log-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.log-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.log-item:last-child {
  border-bottom: none;
}

.log-event {
  font-size: 24rpx;
  color: #ffd700;
  margin-right: 10rpx;
}

.log-choice {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.log-desc {
  font-size: 22rpx;
  color: #fff;
  margin: 5rpx 0;
}

.log-title-text {
  color: #ffd700;
  font-size: 24rpx;
}

.log-icon {
  margin-right: 8rpx;
}
