/* event-card 组件样式 */

.event-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
}

.event-card {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  background: linear-gradient(145deg, #1a1a2e, #16213e);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 顶部状态栏 */
.event-status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.event-progress {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.battery-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #67c23a;
  background: rgba(103, 194, 58, 0.15);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.battery-display.battery-low {
  color: #f56c6c;
  background: rgba(245, 108, 108, 0.15);
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.battery-icon {
  font-size: 28rpx;
}

.battery-value {
  font-weight: 600;
}

.event-type-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.event-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  text-align: left;
  margin-bottom: 12rpx;
}

.event-desc {
  font-size: 28rpx;
  color: #a0a0b0;
  text-align: left;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.choices {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.choice-btn {
  background: linear-gradient(135deg, #2a2a4a, #363660);
  border: 2rpx solid #4a4a6a;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition: all 0.2s;
}

.choice-btn:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #363660, #404070);
}

.choice-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.choice-desc {
  font-size: 24rpx;
  color: #808090;
}

.custom-btn {
  background: linear-gradient(135deg, #3a3a5a, #4a4a7a);
  border: 2rpx dashed #6a6a8a;
}

.custom-btn .choice-text {
  color: #ffd700;
}

/* 自定义输入区域 */
.custom-input-area {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.custom-input {
  background: #2a2a4a;
  border: 2rpx solid #4a4a6a;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #fff;
}

.custom-input::placeholder {
  color: #606080;
}

.custom-actions {
  display: flex;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  background: #3a3a5a;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #a0a0b0;
}

.btn-confirm {
  flex: 1;
  background: linear-gradient(135deg, #4a90d9, #67c23a);
  border: none;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}