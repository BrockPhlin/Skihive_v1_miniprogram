/* 飞行教学页面样式 */
page {
  background: #0f1426;
}

/* 页面基础样式 */
.tutorial-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1f36 0%, #121a30 45%, #0f1426 100%);
  padding-bottom: 120rpx;
  animation: fadeIn 0.6s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(60rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.1);
    opacity: 1;
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-15rpx);
  }
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes successPop {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 顶部进度指示器 */
.progress-header {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  gap: 24rpx;
}

.progress-bar-wrap {
  flex: 1;
}

.step-indicator {
  font-size: 28rpx;
  font-weight: 600;
  color: #cbb8ff;
  min-width: 70rpx;
  text-align: center;
}

/* 步骤标题 */
.step-title-wrap {
  padding: 0 32rpx 24rpx;
}

.step-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.step-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 8rpx;
}

/* 内容区域 */
.content-area {
  padding: 0 24rpx;
  min-height: 700rpx;
}

.step-content {
  display: none;
  animation: slideIn 0.4s ease-out;
}

.step-content.active {
  display: block;
}

/* 步骤1：欢迎 */
.welcome-section {
  padding: 60rpx 24rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.welcome-emblem {
  font-size: 120rpx;
  filter: drop-shadow(0 0 20rpx rgba(143, 108, 255, 0.6));
  animation: float 3.6s ease-in-out infinite;
}
.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.08em;
  text-shadow: 0 0 12rpx rgba(143, 108, 255, 0.6);
}
.welcome-desc {
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
  padding: 0 8rpx;
}
.welcome-divider {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #8f6cff, transparent);
  margin: 20rpx 0;
}
.welcome-tagline {
  font-family: 'Courier New', monospace;
  font-size: 26rpx;
  color: #cbb8ff;
  letter-spacing: 0.1em;
}

/* 步骤2：章节列表 */
.chapters-section {
  padding: 12rpx 0;
}
.section-intro {
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.section-eyebrow {
  font-family: 'Courier New', monospace;
  font-size: 22rpx;
  color: #cbb8ff;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}
.section-headline {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.04em;
}
.section-subtext {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.5;
  margin-top: 4rpx;
}
.chapters-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.chapter-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(143, 108, 255, 0.18);
  border-left: 4rpx solid #8f6cff;
  border-radius: 16rpx;
  gap: 20rpx;
}
.chapter-icon {
  font-size: 44rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(143, 108, 255, 0.15);
  border-radius: 14rpx;
  flex-shrink: 0;
}
.chapter-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.chapter-no {
  font-family: 'Courier New', monospace;
  font-size: 20rpx;
  color: #8f6cff;
  letter-spacing: 0.2em;
}
.chapter-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}
.chapter-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* 步骤3：任务标签云 */
.tasks-section {
  padding: 12rpx 0;
}
.tasks-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.task-chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 22rpx;
  background: rgba(143, 108, 255, 0.1);
  border: 2rpx solid rgba(143, 108, 255, 0.3);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #e8e0ff;
  letter-spacing: 0.02em;
}

/* 步骤4：准备起飞 */
.launch-section {
  padding: 40rpx 8rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}
.launch-eyebrow {
  font-family: 'Courier New', monospace;
  font-size: 22rpx;
  color: #4ade80;
  letter-spacing: 0.3em;
  text-shadow: 0 0 8rpx rgba(74, 222, 128, 0.5);
  animation: pulse 1.6s ease-in-out infinite;
}
.launch-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.06em;
  text-shadow: 0 0 16rpx rgba(143, 108, 255, 0.4);
}
.launch-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.7);
  padding: 0 12rpx;
  margin-bottom: 12rpx;
}
.launch-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 12rpx;
}
.launch-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  min-width: 140rpx;
  background: linear-gradient(135deg, rgba(143, 108, 255, 0.18) 0%, rgba(143, 108, 255, 0.06) 100%);
  border: 2rpx solid rgba(143, 108, 255, 0.35);
  border-radius: 18rpx;
}
.launch-badge-emoji {
  font-size: 44rpx;
  filter: drop-shadow(0 0 6rpx rgba(255, 215, 0, 0.4));
}
.launch-badge-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.04em;
}

/* 步骤1：认识飞行器 */
.drone-intro {
  padding-top: 20rpx;
}

.drone-visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 280rpx;
  margin-bottom: 40rpx;
}

.drone-body {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.drone-core {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #8f6cff 0%, #6f4fd8 100%);
  border-radius: 50%;
  box-shadow: 0 0 30rpx rgba(143, 108, 255, 0.6);
}

.drone-arm {
  position: absolute;
  width: 80rpx;
  height: 16rpx;
  background: linear-gradient(90deg, #4a5568 0%, #718096 100%);
  border-radius: 8rpx;
}

.arm-1 {
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%) rotate(0deg);
}

.arm-2 {
  top: 50%;
  right: 20rpx;
  transform: translateY(-50%) rotate(90deg);
}

.arm-3 {
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%) rotate(180deg);
}

.arm-4 {
  top: 50%;
  left: 20rpx;
  transform: translateY(-50%) rotate(270deg);
}

.propeller {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  background: rgba(143, 108, 255, 0.3);
  border: 3rpx solid rgba(143, 108, 255, 0.6);
  border-radius: 50%;
  animation: rotate 0.3s linear infinite;
}

.p1 {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  animation-duration: 0.2s;
}

.p2 {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  animation-duration: 0.25s;
}

.p3 {
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  animation-duration: 0.22s;
}

.p4 {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  animation-duration: 0.28s;
}

.drone-glow {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(143, 108, 255, 0.15) 0%, transparent 70%);
  animation: pulse 2s ease-in-out infinite;
}

.parts-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.part-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  gap: 20rpx;
}

.part-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 14rpx;
  background: rgba(143, 108, 255, 0.15);
}

.part-icon.battery {
  background: rgba(74, 222, 128, 0.15);
}

.part-icon.camera {
  background: rgba(255, 107, 107, 0.15);
}

.part-icon.propeller-icon {
  background: rgba(255, 182, 71, 0.15);
}

.part-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.part-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.part-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 4rpx;
}

/* 步骤2：基础飞行 */
.flight-simulator {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.simulator-area {
  width: 600rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(143, 108, 255, 0.3);
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.simulator-area.touch-active {
  border-color: #8f6cff;
  box-shadow: 0 0 30rpx rgba(143, 108, 255, 0.4);
  background: rgba(143, 108, 255, 0.08);
}

.drone-sim {
  font-size: 80rpx;
  transition: all 0.3s ease;
  z-index: 2;
}

.drone-sim.flying {
  animation: float 1s ease-in-out infinite;
}

.trajectory {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.trajectory-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: rgba(143, 108, 255, 0.6);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.flight-direction {
  position: absolute;
  padding: 8rpx 20rpx;
  background: rgba(143, 108, 255, 0.2);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #cbb8ff;
  animation: fadeIn 0.3s ease-out;
}

.flight-direction.up {
  top: 40rpx;
  left: 50%;
  transform: translateX(-50%);
}

.flight-direction.down {
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
}

.flight-direction.left {
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
}

.flight-direction.right {
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
}

.simulator-stats {
  display: flex;
  gap: 48rpx;
  margin-top: 32rpx;
  padding: 24rpx 48rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 18rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #8f6cff;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 4rpx;
}

.flight-instructions {
  margin-top: 24rpx;
}

.instruction-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

.achievement-unlock {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 16rpx 32rpx;
  background: rgba(255, 215, 0, 0.1);
  border: 2rpx solid rgba(255, 215, 0, 0.3);
  border-radius: 999rpx;
  animation: successPop 0.5s ease-out;
}

.achievement-badge {
  font-size: 32rpx;
}

.achievement-text {
  font-size: 24rpx;
  color: #ffd700;
  font-weight: 600;
}

/* 步骤3：装配问答 */
.quiz-section {
  padding-top: 20rpx;
}

.quiz-progress {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.quiz-label {
  font-size: 24rpx;
  color: #cbb8ff;
  font-weight: 600;
}

.quiz-bar {
  flex: 1;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.quiz-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #8f6cff 0%, #cbb8ff 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.quiz-card {
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 32rpx;
}

.quiz-question {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.quiz-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.quiz-option {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  gap: 16rpx;
  transition: all 0.2s ease;
}

.quiz-option:active {
  background: rgba(255, 255, 255, 0.08);
}

.quiz-option.correct {
  border-color: #4ade80;
  background: rgba(74, 222, 128, 0.1);
}

.quiz-option.wrong {
  border-color: #f87171;
  background: rgba(248, 113, 113, 0.1);
}

.option-letter {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(143, 108, 255, 0.2);
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #cbb8ff;
}

.quiz-option.correct .option-letter {
  background: rgba(74, 222, 128, 0.3);
  color: #4ade80;
}

.quiz-option.wrong .option-letter {
  background: rgba(248, 113, 113, 0.3);
  color: #f87171;
}

.option-text {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
}

.quiz-result {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 14rpx;
  text-align: center;
}

.quiz-result .result-text {
  font-size: 26rpx;
  font-weight: 600;
}

.quiz-result .result-text.success {
  color: #4ade80;
}

.quiz-result .result-text.fail {
  color: #f87171;
}

/* 步骤4：进阶技巧 */
.tips-section {
  padding-top: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.tip-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  gap: 20rpx;
}

.tip-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: rgba(143, 108, 255, 0.15);
  border-radius: 14rpx;
}

.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.tip-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 4rpx;
  line-height: 1.5;
}

.tip-weather {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.tip-weather.sunny {
  background: rgba(255, 215, 0, 0.15);
  color: #ffd700;
}

.tip-weather.windy {
  background: rgba(107, 182, 255, 0.15);
  color: #6bb3ff;
}

.tip-weather.rainy {
  background: rgba(167, 139, 250, 0.15);
  color: #c4b5fd;
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 40rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(15, 20, 38, 0.95) 20%);
}

.badges-preview {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.badges-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.badges-list {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.badge-item {
  font-size: 28rpx;
}

.nav-button {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #8f6cff 0%, #6f4fd8 100%);
  color: #ffffff;
  border-radius: 999rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 26rpx rgba(88, 67, 166, 0.35);
  transition: all 0.3s ease;
}

.nav-button.disabled {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.4);
  box-shadow: none;
}

.nav-button:active:not(.disabled) {
  transform: scale(0.98);
  box-shadow: 0 6rpx 18rpx rgba(88, 67, 166, 0.25);
}

/* 完成弹窗 */
.completion-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 20, 38, 0.9);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.completion-modal.show {
  display: flex;
  opacity: 1;
}

.modal-content {
  width: 600rpx;
  padding: 48rpx 40rpx;
  background: linear-gradient(180deg, #1a1f36 0%, #121a30 100%);
  border: 2rpx solid rgba(143, 108, 255, 0.3);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: successPop 0.5s ease-out;
}

.completion-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.completion-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.completion-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.final-badges {
  width: 100%;
  margin-bottom: 36rpx;
}

.final-badges-title {
  display: block;
  font-size: 24rpx;
  color: #cbb8ff;
  margin-bottom: 16rpx;
  text-align: center;
}

.final-badges-list {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.final-badge {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(143, 108, 255, 0.15);
  border: 2rpx solid rgba(143, 108, 255, 0.3);
  border-radius: 20rpx;
  font-size: 44rpx;
}

.start-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
  color: #ffffff;
  border-radius: 999rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 700;
