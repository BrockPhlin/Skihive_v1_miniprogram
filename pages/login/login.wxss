/* login.wxss · 深空赛博风登录页 */

.login-page {
  background: var(--space);
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: 100vh;
  color: var(--ink);
  font-family: var(--font-cjk);
}

/* ==================== 状态栏 ==================== */
.status-bar {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 44px;
  z-index: 10;
}
.status-bar image { width: 100%; height: 100%; }

/* ==================== 背景 ==================== */
.background-gradient {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.gradient-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  pointer-events: none;
}
.gradient-circle.primary {
  left: calc(115.95 / 393 * 100%);
  top: 200rpx;
  width: calc(159.45 / 393 * 100%);
  height: 320rpx;
  background: radial-gradient(circle, rgba(255, 181, 71, 0.2) 0%, rgba(255, 181, 71, 0.05) 40%, transparent 70%);
  animation: float 7s ease-in-out infinite;
}
.gradient-circle.accent {
  right: -10%;
  top: 40%;
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, rgba(92, 243, 255, 0.18) 0%, transparent 70%);
  animation: float 9s ease-in-out infinite reverse;
}

.grid-overlay {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(92, 243, 255, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(92, 243, 255, 0.04) 1px, transparent 1px);
  background-size: 60rpx 60rpx;
  mask-image: radial-gradient(ellipse at 50% 30%, #000 20%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 30%, #000 20%, transparent 75%);
  pointer-events: none;
}

/* ==================== 顶部 brand ==================== */
.brand-area {
  position: relative;
  z-index: 10;
  padding-top: 100rpx;
  padding-left: 56rpx;
  padding-right: 56rpx;
  text-align: center;
  animation: pageFadeIn 0.5s ease-out forwards;
}

.brand-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 18rpx;
  background: rgba(92, 243, 255, 0.06);
  border: 1rpx solid var(--line-bright);
  border-radius: var(--r-pill);
  font-size: 20rpx;
  color: var(--cyan);
  letter-spacing: 0.25em;
  margin-bottom: 32rpx;
}

.logo-area {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.logo-image {
  width: 280rpx;
  height: 40rpx;
  filter: drop-shadow(0 0 16rpx rgba(92, 243, 255, 0.4));
}

.logo-subtitle {
  font-size: 22rpx;
  color: var(--ink-dim);
  letter-spacing: 0.3em;
  margin-bottom: 16rpx;
}

.brand-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  font-size: 18rpx;
  color: var(--ink-faint);
  letter-spacing: 0.25em;
}
.meta-dot { color: var(--cyan); opacity: 0.6; }

/* ==================== 头像装饰 ==================== */
.avatar-area {
  position: relative;
  z-index: 5;
  width: 200rpx;
  height: 200rpx;
  margin: 30rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-ring {
  position: absolute;
  inset: 0;
  border: 1rpx solid var(--line-bright);
  border-radius: 50%;
  border-top-color: var(--cyan);
  border-right-color: transparent;
  animation: spin 4s linear infinite;
  box-shadow: 0 0 30rpx rgba(92, 243, 255, 0.18);
}
.avatar-ring.r2 {
  inset: 16rpx;
  border-top-color: var(--gold);
  border-bottom-color: var(--gold);
  border-left-color: transparent;
  border-right-color: transparent;
  animation: spin 6s linear infinite reverse;
  opacity: 0.6;
}

.avatar-core {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle, rgba(92, 243, 255, 0.18) 0%, transparent 70%);
  border: 1rpx solid var(--line-bright);
  border-radius: 50%;
  position: relative;
  z-index: 2;
}
.avatar-glyph {
  font-size: 36rpx;
  color: var(--cyan);
  text-shadow: 0 0 16rpx var(--cyan-glow);
}

/* ==================== 表单 ==================== */
.form-area {
  position: relative;
  z-index: 10;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 40rpx;
  width: calc(316.57 / 393 * 100%);
  max-width: 632rpx;
  padding-bottom: 32rpx;
  transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.form-area.shifted { transform: translateX(-50%) translateY(-180rpx); }

.form-eyebrow {
  font-size: 20rpx;
  color: var(--cyan);
  letter-spacing: 0.3em;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.input-wrap {
  position: relative;
}
.input-wrap::before {
  content: attr(data-prefix);
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--font-mono);
  font-size: 20rpx;
  color: var(--cyan);
  letter-spacing: 0.15em;
  z-index: 2;
  pointer-events: none;
}

.input-field {
  width: 100%;
  height: 96rpx;
  background: rgba(5, 6, 13, 0.6);
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 0 30rpx 0 90rpx;
  font-family: var(--font-mono);
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 0.04em;
  box-sizing: border-box;
  transition: all 0.2s ease-out;
}
.input-field:focus {
  border-color: var(--cyan);
  background: rgba(92, 243, 255, 0.05);
  box-shadow: 0 0 0 2rpx rgba(92, 243, 255, 0.12), 0 0 24rpx rgba(92, 243, 255, 0.2);
  outline: none;
}
.input-placeholder {
  color: var(--ink-mute);
  letter-spacing: 0.2em;
  font-size: 24rpx;
}

.mt-4 { margin-top: 24rpx; }

.input-eye {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: var(--ink-dim);
  padding: 8rpx;
  z-index: 3;
}

.form-actions {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-btn {
  width: 100%;
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-family: var(--font-mono);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.2em;
  line-height: 1;
}
.form-btn::after { border: none; }

.btn-primary.form-btn {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dim) 100%);
  color: #1a0f00;
  border: 2rpx solid var(--gold-bright);
  border-radius: var(--r-md);
  padding: 28rpx 0;
  box-shadow:
    0 0 0 2rpx rgba(255, 181, 71, 0.15) inset,
    0 6rpx 24rpx var(--gold-glow);
  position: relative;
  overflow: hidden;
}
.btn-primary.form-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.4) 50%, transparent 70%);
  background-size: 220% 100%;
  animation: shimmer 2.4s linear infinite;
  pointer-events: none;
  border: none;
}
.btn-primary--active {
  transform: scale(0.97);
  box-shadow: 0 0 0 2rpx var(--gold-bright) inset, 0 0 20rpx var(--gold-glow);
}

.form-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0;
  font-size: 20rpx;
  color: var(--ink-mute);
  letter-spacing: 0.3em;
}
.form-divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, var(--line) 50%, transparent 100%);
}

.btn-wechat {
  background: rgba(7, 193, 96, 0.08);
  border: 2rpx solid rgba(7, 193, 96, 0.4);
  color: #46e6a3;
  border-radius: var(--r-md);
  padding: 26rpx 0;
}
.btn-wechat::after { border: none; }
.btn-wechat--active {
  background: rgba(7, 193, 96, 0.16);
  transform: scale(0.97);
  box-shadow: 0 0 20rpx rgba(7, 193, 96, 0.3);
}
.wechat-icon {
  font-size: 28rpx;
  color: #46e6a3;
  filter: drop-shadow(0 0 8rpx rgba(70, 230, 163, 0.5));
}

.secondary-actions {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
}
.form-link {
  display: inline-block;
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  color: var(--cyan);
  letter-spacing: 0.15em;
  transition: all 0.2s ease-out;
}
.form-link--active {
  color: var(--gold-bright);
  text-shadow: 0 0 12rpx var(--gold-glow);
}

.btn-prefix { font-size: 22rpx; }
.btn-label { letter-spacing: 0.2em; }

/* ==================== 协议 ==================== */
.agreement-area {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 40rpx;
  width: calc(316.57 / 393 * 100%);
  max-width: 632rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  background: rgba(5, 6, 13, 0.6);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  z-index: 10;
  transition: all 0.2s ease-out;
}
.agreement-area--active { border-color: var(--line-bright); background: rgba(92, 243, 255, 0.04); }

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
  border: 1rpx solid var(--line);
  background: rgba(5, 6, 13, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease-out;
}
.checkbox.checked {
  background: var(--cyan);
  border-color: var(--cyan);
  box-shadow: 0 0 12rpx var(--cyan-glow);
}
.checkbox-inner {
  color: var(--void);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.agreement-text {
  font-size: 20rpx;
  color: var(--ink-dim);
  letter-spacing: 0.1em;
  flex: 1;
}
.agreement-link {
  color: var(--cyan);
  text-decoration: underline;
  text-decoration-color: rgba(92, 243, 255, 0.4);
  text-underline-offset: 4rpx;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid rgba(26, 15, 0, 0.2);
  border-top-color: #1a0f00;
  border-right-color: #1a0f00;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
