/* Analytics Page Styles - Dark Theme */

.analytics-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 0 30rpx 120rpx;
  box-sizing: border-box;
}

/* ==================== Page Header ==================== */
.page-header {
  padding: 120rpx 0 40rpx;
  text-align: center;
}

.page-title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(255, 255, 255, 1) 17%, rgba(199, 188, 227, 1) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ==================== Section Common ==================== */
.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.section-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.section-rate {
  font-size: 36rpx;
  font-weight: bold;
  color: #855ee3;
}

/* ==================== Fade In Animation ==================== */
.fade-in {
  animation: fadeIn 0.6s ease-out forwards;
  opacity: 0;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Stagger animations for cards */
.stagger-0 { animation-delay: 0.1s; }
.stagger-1 { animation-delay: 0.2s; }
.stagger-2 { animation-delay: 0.3s; }

/* ==================== Radar Section ==================== */
.radar-section {
  background: rgba(22, 33, 62, 0.6);
  border-radius: 28rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.radar-container {
  display: flex;
  justify-content: center;
  margin: 30rpx 0;
}

.personality-tags {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}

.personality-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(133, 94, 227, 0.2);
  border-radius: 16rpx;
  border: 1rpx solid rgba(133, 94, 227, 0.3);
}

.tag-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tag-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 6rpx;
}

/* ==================== Statistics Cards ==================== */
.stats-section {
  margin-top: 30rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.stat-card {
  background: rgba(22, 33, 62, 0.6);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  opacity: 0;
  animation: fadeIn 0.5s ease-out forwards;
}

.stat-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon::before {
  font-size: 28rpx;
}

.icon-time {
  background: linear-gradient(135deg, rgba(133, 94, 227, 0.3) 0%, rgba(133, 94, 227, 0.1) 100%);
}

.icon-time::before {
  content: '⏱';
}

.icon-flight {
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.3) 0%, rgba(34, 197, 94, 0.1) 100%);
}

.icon-flight::before {
  content: '✈';
}

.icon-task {
  background: linear-gradient(135deg, rgba(253, 203, 110, 0.3) 0%, rgba(253, 203, 110, 0.1) 100%);
}

.icon-task::before {
  content: '✓';
}

.stat-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

/* ==================== Progress Section ==================== */
.progress-section {
  background: rgba(22, 33, 62, 0.6);
  border-radius: 28rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.progress-container {
  margin: 24rpx 0 16rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
}

.progress-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ==================== Trend Section ==================== */
.trend-section {
  background: rgba(22, 33, 62, 0.6);
  border-radius: 28rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.trend-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.trend-card {
  display: flex;
  align-items: center;
}

.trend-label {
  width: 80rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.trend-bar-container {
  flex: 1;
  margin: 0 20rpx;
}

.trend-value {
  width: 120rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: right;
}

/* ==================== Summary Section ==================== */
.summary-section {
  background: rgba(22, 33, 62, 0.6);
  border-radius: 28rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.summary-content {
  display: flex;
  flex-wrap: wrap;
}

.summary-item {
  width: 50%;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.summary-value.highlight {
  color: #855ee3;
}

.summary-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* ==================== Personality Section ==================== */
.personality-section {
  background: rgba(22, 33, 62, 0.6);
  border-radius: 28rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.personality-bars {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.personality-bar-item {
  display: flex;
  flex-direction: column;
}

.personality-bar-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.personality-bar-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.personality-bar-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.personality-bar-track {
  width: 100%;
}

/* ==================== Empty State ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 60rpx;
}

.start-fly-btn {
  background: linear-gradient(135deg, #855ee3 0%, #6c4bd4 100%);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 40rpx rgba(133, 94, 227, 0.4);
}

.start-fly-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}