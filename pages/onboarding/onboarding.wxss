/* onboarding.wxss · 首次启动产品介绍 — 4 张纯 CSS 海报 */
/* 注意：任何 display:flex 都会让 swiper-item 卡顿，全部使用 block + inline-block */

page { background: #03040a; }

.onboarding-page { position:relative; width:100%; height:100vh; background:linear-gradient(180deg,#03040a 0%,#05060d 50%,#0a0d1c 100%); display:flex; flex-direction:column; overflow:hidden; }
.onboarding-swiper { flex:1; width:100%; }
.onboarding-slide { height:100%; padding-top:100rpx; box-sizing:border-box; }
.poster { width:90%; margin:0 auto; border-radius:32rpx; padding:30rpx; box-sizing:border-box; box-shadow:0 16rpx 64rpx rgba(0,0,0,0.6); }

/* === SLIDE 1 === */
.poster-1 { background:linear-gradient(165deg,#0b0e2e 0%,#151a45 40%,#1c2b6d 100%); border:2rpx solid rgba(92,243,255,0.2); position:relative; }
.p1-glow { position:absolute; border-radius:50%; filter:blur(60rpx); pointer-events:none; }
.p1-glow-1 { top:-60rpx; right:-80rpx; width:360rpx; height:360rpx; background:radial-gradient(circle,rgba(92,243,255,0.15),transparent 70%); }
.p1-glow-2 { bottom:120rpx; left:-80rpx; width:320rpx; height:320rpx; background:radial-gradient(circle,rgba(167,139,255,0.12),transparent 70%); }
.p1-room { position:relative; height:340rpx; margin-bottom:32rpx; }
.p1-window { position:absolute; top:0; left:50%; transform:translateX(-50%); width:280rpx; height:300rpx; border:2rpx solid rgba(92,243,255,0.25); border-radius:16rpx 16rpx 0 0; background:linear-gradient(180deg,#0d1338 0%,#1a2356 40%,#2a3570 100%); overflow:hidden; }
.p1-stars { position:absolute; top:8rpx; left:0; width:100%; height:60rpx; background-image:radial-gradient(4rpx 4rpx at 20% 30%,#fff 50%,transparent),radial-gradient(4rpx 4rpx at 40% 10%,#5cf3ff 50%,transparent),radial-gradient(3rpx 3rpx at 60% 40%,#fff 50%,transparent),radial-gradient(3rpx 3rpx at 80% 20%,#ffb547 50%,transparent),radial-gradient(4rpx 4rpx at 10% 50%,#a78bff 50%,transparent),radial-gradient(3rpx 3rpx at 50% 5%,#fff 50%,transparent),radial-gradient(3rpx 3rpx at 70% 50%,#5cf3ff 50%,transparent),radial-gradient(4rpx 4rpx at 90% 30%,#fff 50%,transparent); background-size:100% 100%; background-repeat:no-repeat; }
.p1-city { position:absolute; bottom:0; left:0; right:0; height:100rpx; background-image:linear-gradient(90deg,transparent 10%,rgba(92,243,255,0.12) 15%,transparent 18%,transparent 25%,rgba(167,139,255,0.15) 30%,transparent 35%,transparent 42%,rgba(92,243,255,0.1) 48%,transparent 55%,transparent 60%,rgba(255,181,71,0.1) 65%,transparent 72%,transparent 80%,rgba(92,243,255,0.08) 85%,transparent 90%); background-position:0 70rpx; }
.p1-figure { position:absolute; bottom:100rpx; left:50%; transform:translateX(-50%); width:60rpx; height:90rpx; background:radial-gradient(ellipse at center,rgba(92,243,255,0.2),transparent); }
.p1-desk { text-align:center; margin-top:270rpx; }
.p1-desk text+text { margin-left:8rpx; }
.p1-title { text-align:center; font-size:32rpx; font-weight:700; color:#fff; letter-spacing:0.04em; margin-bottom:12rpx; text-shadow:0 0 24rpx rgba(92,243,255,0.3); }
.p1-subtitle { text-align:center; font-size:24rpx; color:rgba(255,255,255,0.6); line-height:1.5; }

/* === SLIDE 2 === */
.poster-2 { background:linear-gradient(165deg,#0f0936 0%,#1a1058 40%,#1b1470 100%); border:2rpx solid rgba(167,139,255,0.25); }
.p2-label { display:block; font-size:20rpx; color:var(--cyan); letter-spacing:0.3em; margin-bottom:24rpx; }
.p2-cards { margin-bottom:28rpx; }
.p2-card { display:inline-block; width:46%; vertical-align:top; text-align:center; padding:20rpx 12rpx; margin:0 1% 16rpx; background:rgba(255,255,255,0.05); border:2rpx solid rgba(167,139,255,0.15); border-radius:18rpx; box-sizing:border-box; }
.p2-emoji { display:block; font-size:44rpx; margin-bottom:8rpx; }
.p2-name { display:block; font-size:24rpx; color:#fff; font-weight:600; margin-bottom:4rpx; }
.p2-desc { display:block; font-size:20rpx; color:rgba(255,255,255,0.5); }
.p2-card-5 { display:block; width:96%; }
.p2-title { text-align:center; font-size:30rpx; font-weight:700; color:#fff; margin-bottom:8rpx; text-shadow:0 0 20rpx rgba(167,139,255,0.25); }
.p2-subtitle { text-align:center; font-size:22rpx; color:rgba(255,255,255,0.55); }

/* === SLIDE 3 === */
.poster-3 { background:linear-gradient(165deg,#0a1a20 0%,#082c38 40%,#06596a 100%); border:2rpx solid rgba(92,243,255,0.2); }
.p3-label { display:block; font-size:20rpx; color:var(--gold); letter-spacing:0.3em; margin-bottom:28rpx; }
.p3-step { border:2rpx solid rgba(92,243,255,0.12); border-radius:16rpx; padding:16rpx; margin-bottom:12rpx; }
.p3-num { display:inline-block; font-size:28rpx; font-weight:700; color:var(--cyan); width:52rpx; vertical-align:middle; }
.p3-info { display:inline-block; width:calc(100% - 200rpx); vertical-align:middle; }
.p3-name { display:block; font-size:26rpx; color:#fff; font-weight:600; }
.p3-desc { display:block; font-size:20rpx; color:rgba(255,255,255,0.5); }
.p3-icon { display:inline-block; width:48rpx; height:48rpx; line-height:48rpx; text-align:center; font-size:36rpx; background:rgba(92,243,255,0.12); border-radius:12rpx; vertical-align:middle; }
.p3-title { text-align:center; font-size:28rpx; font-weight:700; color:#fff; margin-bottom:6rpx; text-shadow:0 0 16rpx rgba(92,243,255,0.2); }
.p3-subtitle { text-align:center; font-size:20rpx; color:rgba(255,255,255,0.5); letter-spacing:0.05em; }
.p3-line { height:0; } /* removed, vertical spacers not needed */

/* === SLIDE 4 === */
.poster-4 { background:linear-gradient(165deg,#1a0f1a 0%,#2a1535 40%,#3a1f50 100%); border:2rpx solid rgba(255,181,71,0.2); }
.p4-task { border:2rpx solid rgba(255,181,71,0.12); border-radius:18rpx; padding:18rpx 20rpx; margin-bottom:14rpx; }
.p4-emoji { display:inline-block; width:48rpx; height:48rpx; line-height:48rpx; text-align:center; font-size:36rpx; background:rgba(255,181,71,0.12); border-radius:12rpx; vertical-align:middle; }
.p4-info { display:inline-block; width:calc(100% - 160rpx); vertical-align:middle; margin-left:14rpx; }
.p4-name { display:block; font-size:24rpx; color:#fff; font-weight:600; }
.p4-desc { display:block; font-size:20rpx; color:rgba(255,255,255,0.5); }
.p4-drone { display:inline-block; width:48rpx; text-align:center; font-size:32rpx; vertical-align:middle; opacity:0.4; }
.p4-title { text-align:center; font-size:30rpx; font-weight:700; color:#fff; margin-bottom:8rpx; text-shadow:0 0 20rpx rgba(255,181,71,0.25); }
.p4-subtitle { text-align:center; font-size:22rpx; color:rgba(255,255,255,0.55); }

/* ==================== 底部 ==================== */
.dots { position:absolute; bottom:160rpx; left:50%; transform:translateX(-50%); white-space:nowrap; z-index:10; }
.dot { display:inline-block; width:16rpx; height:16rpx; border-radius:50%; background:rgba(255,255,255,0.25); margin:0 8rpx; transition:all 0.3s ease-out; }
.dot-active { width:40rpx; border-radius:8rpx; background:linear-gradient(90deg,var(--cyan) 0%,var(--gold) 100%); box-shadow:0 0 12rpx var(--cyan-glow); }
.bottom-bar { position:absolute; bottom:60rpx; left:0; right:0; text-align:center; z-index:10; }
.skip-btn { display:inline-block; padding:18rpx 36rpx; font-size:26rpx; color:var(--ink-mute); background:rgba(255,255,255,0.06); border:1rpx solid var(--line); border-radius:999rpx; letter-spacing:0.1em; }
.enter-btn { display:inline-block; padding:26rpx 80rpx; background:linear-gradient(135deg,var(--gold) 0%,var(--gold-dim) 100%); color:#1a0f00; border:2rpx solid var(--gold-bright); border-radius:999rpx; font-size:30rpx; font-weight:700; letter-spacing:0.2em; box-shadow:0 0 0 2rpx rgba(255,181,71,0.15) inset,0 10rpx 32rpx var(--gold-glow); position:relative; overflow:hidden; }
.enter-btn::after { content:''; position:absolute; inset:0; background:linear-gradient(115deg,transparent 30%,rgba(255,255,255,0.4) 50%,transparent 70%); background-size:220% 100%; animation:shimmer 2.4s linear infinite; pointer-events:none; }
@keyframes shimmer { from { background-position:-220% 0; } to { background-position:220% 0; } }
@keyframes float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-8rpx); } }
