/* task-card.wxss */
.task-card-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1f36 0%, #121a30 50%, #0f1426 100%);
  padding-bottom: 160rpx;
}

.tip-text {
  text-align: center;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  margin: 24rpx 0 30rpx;
}

.task-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  margin-top: 12rpx;
}

.task-item {
  width: 48%;
  margin-right: 4%;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 8rpx 22rpx rgba(8, 11, 24, 0.28);
}

.task-item:nth-child(2n) {
  margin-right: 0;
}

.task-item.selected {
  border-color: #8f6cff;
  background: rgba(143, 108, 255, 0.15);
  box-shadow: 0 8rpx 28rpx rgba(143, 108, 255, 0.3);
}

.task-item:active {
  transform: scale(0.98);
}

.task-image {
  width: 100%;
  height: 200rpx;
  display: block;
}

.task-name {
  padding: 18rpx 16rpx 22rpx;
  font-size: 24rpx;
  color: #ffffff;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 600;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  padding-bottom: 60rpx;
  background: rgba(26, 31, 54, 0.95);
}

.btn-primary {
  width: 100%;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8f6cff 0%, #6f4fd8 100%);
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 28rpx rgba(88, 67, 166, 0.4);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.99);
}
