/* flight-records.wxss */
.flight-records-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e0e0e0;
}

.nav-back {
  font-size: 40rpx;
  color: #333;
  padding: 10rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.nav-placeholder {
  width: 60rpx;
}

.records-list {
  padding: 30rpx;
}

.record-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-task {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.record-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.record-score {
  font-size: 28rpx;
  color: #855ee3;
  font-weight: bold;
}

.delete-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 8rpx 16rpx;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
}

.record-body {
  display: flex;
  flex-direction: column;
}

.record-info {
  display: flex;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.record-info:last-child {
  margin-bottom: 0;
}

.record-info .label {
  color: #999;
  width: 140rpx;
}

.record-info .value {
  color: #666;
  flex: 1;
}

.record-drone {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.drone-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.drone-config {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.empty-sub {
  font-size: 28rpx;
  color: #999;
}

.login-btn {
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  background: #855ee3;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
}